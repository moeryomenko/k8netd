# k8netd user quadlet (plan: podman-quadlet-for-k8netd, D2/D3/D6/D7).
#
# Install (UID 1000 lab convention — the Go provider hardcodes
# /run/user/1000/k8snet, internal/chclient/vhostuser.go:30):
#   install -D -m 644 deploy/k8netd.container \
#       ~/.config/containers/systemd/k8netd.container
#   sudo loginctl enable-linger $USER   # keep the unit alive without a session
#   systemctl --user daemon-reload
#   systemctl --user start k8netd
#
# Production uses the immutable release image; local development may override
# Image= before installing this unit.

[Unit]
Description=k8netd rootless userspace L2 switch for cloud-hypervisor VMs
Wants=default.target
After=default.target

[Container]
Image=ghcr.io/moeryomenko/k8netd:v0.2.2
Network=host

# Single bind, identical paths both sides (grill D6): control.sock, every
# <port>.sock vhost-user endpoint, and the REQ-010 state.json all live here.
# cloud-hypervisor dials these exact paths from OUTSIDE the container.
Mount=type=bind,source=/run/user/1000/k8snet,target=/run/user/1000/k8snet

# Explicit pins (grill D7) — every K8NETD_* value stated, no implicit defaults.
# Inbound forwards come exclusively from the PublishPort RPC (REQ-010/REQ-011);
# K8NETD_PUBLISH_RANGE bounds the host-port allocator.
Environment=K8NETD_SOCKET_DIR=/run/user/1000/k8snet
Environment=K8NETD_PASST_BINARY=passt
Environment=K8NETD_UPSTREAM_DNS=1.1.1.1,8.8.8.8
Environment=K8NETD_MTU=1500
Environment=K8NETD_PUBLISH_RANGE=20000-21000

[Service]
Restart=always

# The bind-mount source must exist before podman creates the container:
# /run is tmpfs so /run/user/1000/k8snet vanishes across reboots, and
# podman statfs-fails container creation before k8netd could recreate it.
ExecStartPre=/usr/bin/mkdir -p /run/user/1000/k8snet

# Conservative hardening on top of an already-rootless container (grill D7).
# Verified against passt subprocess behavior on the lab host; relax
# RestrictAddressFamilies first if passt fails to bind its forwards.
NoNewPrivileges=true
# No ProtectHome/ProtectSystem: rootless podman needs writable $HOME storage
# (~/.local/share/containers) and runroot ($XDG_RUNTIME_DIR/containers).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
